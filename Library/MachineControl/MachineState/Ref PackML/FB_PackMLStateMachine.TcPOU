<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PackMLStateMachine" Id="{cf7e90d4-3aad-4ab5-82e1-f33dada3ea03}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PackMLStateMachine
VAR_INPUT
	eUnitMode 			: E_PackMLUnitMode;
	eCommand			: E_PackMLCommand;
END_VAR
VAR_IN_OUT
	stSubUnitInfo		: ARRAY[*] OF ST_PMLSubUnitInfo; 
END_VAR
VAR_OUTPUT
	eState				: E_PackMLState := E_PackMLState.Idle;
	Error 				: BOOL;
	ErrorID 			: UDINT;
END_VAR
VAR
	eCommandPrev		: E_PackMLCommand;
	bCommandRise		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// コマンドの立ち上がり検出 (前回スキャンから変更があった場合のみ受付)
bCommandRise := (eCommand <> E_PackMLCommand.Undefined) AND (eCommand <> eCommandPrev);
eCommandPrev := eCommand;

//ステートチェンジ判定
Error 	:= FALSE;
ErrorID := 0;

CASE eUnitMode OF
	
	E_PackMLUnitMode.Production:
		StateMachine_Production();
		
	E_PackMLUnitMode.Maintenance:
		StateMachine_Maintenance();
		
	E_PackMLUnitMode.Manual:
		StateMachine_Manual();
		
END_CASE

]]></ST>
    </Implementation>
    <Method Name="StateMachine_Maintenance" Id="{e6820e7a-bec5-4535-b0f7-a72f6e3a959d}">
      <Declaration><![CDATA[METHOD StateMachine_Maintenance
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eState OF
	E_PackMLState.Undefined:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Idle:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Start THEN
			eState	:= E_PackMLState.Starting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Starting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Execute:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Hold THEN
			eState	:= E_PackMLState.Holding;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Resetting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Idle) THEN
			eState	:= E_PackMLState.Idle;
		END_IF
	
	E_PackMLState.Holding:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Held) THEN
			eState	:= E_PackMLState.Held;
		END_IF

	E_PackMLState.Held:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Unhold THEN
			eState	:= E_PackMLState.Unholding;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Unholding:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Stopping:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

	E_PackMLState.Stopped:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Reset THEN
			eState	:= E_PackMLState.Resetting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Aborting:

		IF SubUnitStateComplete(eTarget:=E_PackMLState.Aborted) THEN
			eState	:= E_PackMLState.Aborted;
		END_IF

	E_PackMLState.Aborted:

		IF eCommand=E_PackMLCommand.Clear THEN
			eState	:= E_PackMLState.Clearing;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Clearing:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateMachine_Manual" Id="{bb7bd523-2822-4c51-837f-e2f4b0539b59}">
      <Declaration><![CDATA[METHOD StateMachine_Manual
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eState OF
	E_PackMLState.Undefined:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Idle:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Start THEN
			eState	:= E_PackMLState.Starting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Starting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Execute:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF


	E_PackMLState.Resetting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Idle) THEN
			eState	:= E_PackMLState.Idle;
		END_IF

	E_PackMLState.Stopping:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

	E_PackMLState.Stopped:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Reset THEN
			eState	:= E_PackMLState.Resetting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Aborting:

		IF SubUnitStateComplete(eTarget:=E_PackMLState.Aborted) THEN
			eState	:= E_PackMLState.Aborted;
		END_IF

	E_PackMLState.Aborted:

		IF eCommand=E_PackMLCommand.Clear THEN
			eState	:= E_PackMLState.Clearing;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Clearing:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateMachine_Production" Id="{6ea19434-5511-41c4-9812-71c4af045ab2}">
      <Declaration><![CDATA[METHOD StateMachine_Production
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eState OF
	E_PackMLState.Undefined:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Idle:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Start THEN
			eState	:= E_PackMLState.Starting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Starting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Execute:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Suspend THEN
			eState	:= E_PackMLState.Suspending;
		ELSIF eCommand=E_PackMLCommand.Hold THEN
			eState	:= E_PackMLState.Holding;
		ELSIF eCommand=E_PackMLCommand.Complete THEN
			eState	:= E_PackMLState.Completing;		
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Completing:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Completed) THEN
			eState	:= E_PackMLState.Completed;
		END_IF

	E_PackMLState.Completed:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Reset THEN
			eState	:= E_PackMLState.Resetting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Resetting:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Idle) THEN
			eState	:= E_PackMLState.Idle;
		END_IF

	E_PackMLState.Holding:
		
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Held) THEN
			eState	:= E_PackMLState.Held;
		END_IF

	E_PackMLState.Held:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Unhold THEN
			eState	:= E_PackMLState.Unholding;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Unholding:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Suspending:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Suspended) THEN
			eState	:= E_PackMLState.Suspended;
		END_IF

	E_PackMLState.Suspended:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF eCommand=E_PackMLCommand.Unsuspend THEN
			eState	:= E_PackMLState.Unsuspending;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF
	
	E_PackMLState.Unsuspending:
	
		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Stop THEN
			eState	:= E_PackMLState.Stopping;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Execute) THEN
			eState	:= E_PackMLState.Execute;
		END_IF

	E_PackMLState.Stopping:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

	E_PackMLState.Stopped:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF eCommand=E_PackMLCommand.Reset THEN
			eState	:= E_PackMLState.Resetting;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Aborting:

		IF SubUnitStateComplete(eTarget:=E_PackMLState.Aborted) THEN
			eState	:= E_PackMLState.Aborted;
		END_IF

	E_PackMLState.Aborted:

		IF eCommand=E_PackMLCommand.Clear THEN
			eState	:= E_PackMLState.Clearing;
		ELSIF bCommandRise THEN
			Error 	:= TRUE;
			ErrorID	:= 1;
		END_IF

	E_PackMLState.Clearing:

		IF eCommand=E_PackMLCommand.Abort THEN
			eState	:= E_PackMLState.Aborting;
		ELSIF SubUnitStateComplete(eTarget:=E_PackMLState.Stopped) THEN
			eState	:= E_PackMLState.Stopped;
		END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SubUnitStateComplete" Id="{ffee066b-ec87-4feb-94d3-ea6f9f189795}">
      <Declaration><![CDATA[METHOD SubUnitStateComplete :BOOL
VAR_INPUT
    eTarget	: E_PackMLState;
END_VAR
VAR
	i					: DINT;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := LOWER_BOUND(stSubUnitInfo,1) TO UPPER_BOUND(stSubUnitInfo,1) DO
	IF stSubUnitInfo[i].bActive AND_THEN stSubUnitInfo[i].eState <> eTarget THEN
		SubUnitStateComplete := FALSE;
		RETURN;
	END_IF
END_FOR
 
SubUnitStateComplete := TRUE;]]></ST>
      </Implementation>
    </Method>
